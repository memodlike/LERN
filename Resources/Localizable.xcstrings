    "A day counts when you read a thought in the feed. A freeze automatically covers one missed day. Earn one freeze every seven reading days, up to three. Opening the app twice never counts as two days.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day counts when you read a thought in the feed. A freeze automatically covers one missed day. Earn one freeze every seven reading days, up to three. Opening the app twice never counts as two days."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День засчитывается, когда вы читаете запись в ленте. Заморозка автоматически сохраняет серию за один пропущенный день. За каждые семь дней чтения вы получаете одну заморозку, максимум — три. Повторное открытие приложения не добавляет день."
          }
        }
      }
    },
    "Add LERN to your Lock Screen from the wallpaper editor. This source is independent of Home Screen presets.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add LERN to your Lock Screen from the wallpaper editor. This source is independent of Home Screen presets."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте LERN на экран блокировки в редакторе обоев. Его источник не зависит от виджетов экрана «Домой»."
          }
        }
      }
    },
    "Add LERN's Get Wallpaper action.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add LERN's Get Wallpaper action."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте действие LERN «Получить обои»."
          }
        }
      }
    },
    "Add a LERN widget from your Home Screen, then edit it to choose a saved preset. iOS decides the final refresh time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a LERN widget from your Home Screen, then edit it to choose a saved preset. iOS decides the final refresh time."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте виджет LERN на экран «Домой» и выберите сохранённый вариант в его настройках. Точное время обновления определяет iOS."
          }
        }
      }
    },
    "Allow photo access in Settings to save images. You can also use Share image and Save to Files.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow photo access in Settings to save images. You can also use Share image and Save to Files."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите добавление фото в настройках. Также можно выбрать «Поделиться изображением» и сохранить его в «Файлы»."
          }
        }
      }
    },
    "Available apps appear in the iOS share sheet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available apps appear in the iOS share sheet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступные приложения появятся в системном меню отправки."
          }
        }
      }
    },
    "Choose a Watch source in LERN on your iPhone, then tap Sync to Watch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a Watch source in LERN on your iPhone, then tap Sync to Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите источник для часов в LERN на iPhone и нажмите «Передать на часы»."
          }
        }
      }
    },
    "Choose your Lock Screen and the automation's run behavior.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your Lock Screen and the automation's run behavior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите экран блокировки и способ запуска автоматизации."
          }
        }
      }
    },
    "Create a personal Time of Day automation in Shortcuts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a personal Time of Day automation in Shortcuts."
          }
        },
        "ru": {
